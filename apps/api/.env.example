# Copy to .env (gitignored) for local runs. Never commit real secrets.
DATABASE_URL="postgresql://klymon:klymon@localhost:5432/klymon?schema=public"
# At least 32 chars in production; the app refuses to boot with the default outside dev.
JWT_SECRET="dev-only-change-me-please-0123456789"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=3001
# Comma-separated origins allowed to call the API from a browser (dashboards later).
FRONTEND_URL="http://localhost:3000"
# Global rate limit (requests per minute per IP).
RATE_LIMIT_PER_MINUTE=100
# Reverse-proxy hops to trust for client IPs (throttler + audit).
# 0 = direct exposure; 1 = behind Coolify/traefik/nginx.
TRUST_PROXY=0
# Return verification/reset tokens in request responses (e2e/dev only — never true in production).
DEV_EXPOSE_TOKENS="false"
# Account-web base used to build email links (placeholder until the real domain exists).
PUBLIC_WEB_URL="https://account.klymon.example"
# Mail delivery: unset SMTP_HOST = log-only dev mailer; set it (+ user/pass) = real SMTP.
MAIL_FROM="Klymon <no-reply@klymon.example>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
